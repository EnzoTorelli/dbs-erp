@model List<DBS.Models.Pedido>
@{
    ViewData["Title"] = "Vendas";
    ViewData["Pagina"] = "Vendas";
}

@section Styles {
    <link rel="stylesheet" href="~/css/vendas.css" />
}

<div class="page-wrap">

    <div class="page-header">
        <div>
            <br>
            <h1>Vendas</h1>
            <span>Controle de vendas realizadas</span>
        </div>
        <button class="btn-novo" onclick="abrirModal()">+ Nova Venda</button>
    </div>

    <div class="barra-busca">
        <input type="text" id="campoBusca" placeholder="Buscar cliente..." oninput="filtrarTabela()" />
        <select id="filtroStatus" onchange="filtrarTabela()">
            <option value="">Todos</option>
            <option value="pago">Pago</option>
            <option value="pendente">Pendente</option>
        </select>
    </div>

    <div class="painel">
        <table class="tabela" id="tabelaVendas">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Cliente</th>
                    <th>Valor</th>
                    <th>Data</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" style="text-align:center; color:#888;">Nenhuma venda registrada.</td>
                    </tr>
                }
                @foreach (var venda in Model)
                {
                    <tr>
                        <td>#@venda.Id</td>
                        <td>@venda.ClienteNome</td>
                        <td>R$ @venda.ValorTotal.ToString("N2")</td>
                        <td>@(venda.DataPedido != DateTime.MinValue ? venda.DataPedido.ToString("dd/MM/yyyy") : "—")</td>
                        <td>
                            <span class="status @(venda.Status?.ToLower() == "pago" ? "pago" : "pendente")">
                                @(venda.Status ?? "Pendente")
                            </span>
                        </td>
                        <td>
                            <button class="btn-acao editar">Editar</button>
                            <form method="post" asp-action="Excluir" asp-route-id="@venda.Id" style="display:inline"
                                  onsubmit="return confirm('Excluir venda #@venda.Id?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-acao excluir">Excluir</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

<!-- Modal -->
<div class="modal-overlay" id="modalVenda">
    <div class="modal">
        <div class="modal-header">
            <h2>Nova Venda</h2>
            <button type="button" class="modal-fechar" onclick="fecharModal()">×</button>
        </div>

        <form method="post" asp-action="Salvar">
            @Html.AntiForgeryToken()

            <div class="form-grupo">
                <label>ID do Cliente</label>
                <input type="number" name="IdCliente" placeholder="Ex: 1" />
            </div>

            <div class="form-grupo">
                <label>Status</label>
                <select name="Status">
                    <option value="Pendente">Pendente</option>
                    <option value="Pago">Pago</option>
                </select>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-cancelar" onclick="fecharModal()">Cancelar</button>
                <button type="submit" class="btn-salvar">Salvar Venda</button>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <script>
        function abrirModal() {
            document.getElementById('modalVenda').classList.add('aberto');
        }
        function fecharModal() {
            document.getElementById('modalVenda').classList.remove('aberto');
        }
        document.getElementById('modalVenda').addEventListener('click', function (e) {
            if (e.target === this) fecharModal();
        });

        function filtrarTabela() {
            const termo = document.getElementById('campoBusca').value.toLowerCase();
            const status = document.getElementById('filtroStatus').value.toLowerCase();
            const linhas = document.querySelectorAll('#tabelaVendas tbody tr');
            linhas.forEach(linha => {
                const textoOk = linha.textContent.toLowerCase().includes(termo);
                const statusOk = status === '' || linha.textContent.toLowerCase().includes(status);
                linha.style.display = textoOk && statusOk ? '' : 'none';
            });
        }
    </script>
}
